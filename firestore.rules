rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección 'utenti' (usuarios)
    match /utenti/{userId} {
      // Permite crear documento (registro)
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Solo el usuario puede leer su propio documento
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Solo el usuario puede actualizar su propio documento
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para la colección 'appointments' (citas)
    match /appointments/{appointmentId} {
      // Todos los usuarios autenticados pueden leer todas las citas
      allow read: if request.auth != null;

      // Usuarios autenticados pueden crear citas
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;

      // Solo el usuario que creó la cita puede actualizarla (para cancelar)
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Admin (email específico) puede actualizar cualquier cita
      allow update: if request.auth != null &&
        request.auth.email == 'peniucrodika@gmail.com';
        
      // Todos pueden eliminar sus propias citas
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }
  }
}